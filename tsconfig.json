  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "types": ["bun"], "allowImportingTsExtensions": true, "resolveJsonModule": true
  },
  "include": ["plugins/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
