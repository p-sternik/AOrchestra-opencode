{
  "name": "aorchestra-opencode-v2",
  "version": "0.8.0",
  "type": "module",
  "description": "A brownfield harness for OpenCode V2 with selective delegation and global setup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-sternik/AOrchestra-opencode.git"
  },
  "homepage": "https://github.com/p-sternik/AOrchestra-opencode#readme",
  "bin": {
    "aorchestra": "./bin/aorchestra.mjs"
  },
  "exports": {
    ".": "./plugins/aorchestra.ts",
    "./server": "./plugins/aorchestra.ts",
    "./tui": "./plugins/aorchestra-tui.tsx"
  },
  "files": [
    "bin",
    "lib",
    "plugins",
    "scripts/cli.ts",
    "scripts/update.ts",
    "scripts/check.ts",
    "scripts/runtime.ts",
    "scripts/report.ts",
    "instructions",
    "skills/repo-context",
    "skills/improve",
    "opencode.json",
    "README.md",
    "docs",
    "VALIDATION.md",
    "RESEARCH.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --conditions=browser --preload=@opentui/solid/preload ./tests",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun scripts/package-check.ts",
    "check": "bun scripts/check.ts",
    "report": "bun scripts/report.ts",
    "eval:check": "bun scripts/eval.ts check",
    "eval:run": "bun scripts/eval.ts run"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@types/bun": "1.2.15",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@opencode/client": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@opencode/theme": "2.0.26",
    "@opencode/util": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "jsonc-parser": "3.3.1",
    "solid-js": "1.9.12"
  }
}
